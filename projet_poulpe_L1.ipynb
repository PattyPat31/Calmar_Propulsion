def volume(t):

    """
    Renvoie le volume interne de l’animal au temps t.
    """

    tau = t % T_cycle

    # phase de contraction
    if tau < T_contract:

        return V_max - (V_max - V_min) * (tau / T_contract)

    # phase d’expansion
    else:

        tau2 = tau - T_contract

        return V_min + (V_max - V_min) * (tau2 / T_expand)


