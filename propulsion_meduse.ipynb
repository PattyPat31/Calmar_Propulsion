import numpy as np
import matplotlib.pyplot as plt

# =========================
# Paramètres
# =========================

rho_fluid = 1025
g = 9.81
Cd = 0.5

R = 0.10                # rayon externe (m)
e = 0.1*R               # épaisseur paroi (m)
D_orifice = 0.02        # diamètre orifice (m)
A_orifice = np.pi*D_orifice**2/4 # section orifice (m^2)

V_ext = (4/3)*np.pi*R**3
V_max = (4/3)*np.pi*(R - e)**3
V_min = 0.1 * V_max

rho_body = 1080
m_body = rho_body * (V_ext - V_max)

m_added_coeff = 0.5
S = np.pi * R**2

# =========================
# Cycle
# =========================

T_contract = 0.5
T_expand = 2.0
T_cycle = T_contract + T_expand

def volume(t):
    tau = t % T_cycle
    if tau < T_contract:
        return V_max - (V_max - V_min) * (tau / T_contract)
    else:
        tau2 = tau - T_contract
        return V_min + (V_max - V_min) * (tau2 / T_expand)

def dVdt(t):
    tau = t % T_cycle
    if tau < T_contract:
        return -(V_max - V_min) / T_contract
    else:
        return (V_max - V_min) / T_expand

# =========================
# Simulation
# =========================

dt = 0.001
T = 10
N = int(T/dt)

t = np.linspace(0, T, N)
z = np.zeros(N)
v = np.zeros(N)
vol = V_max*np.ones(N)
acc = np.zeros(N)

for i in range(N-1):

    V = volume(t[i])
    dV = dVdt(t[i])

    # Masse
    m_fluid = rho_fluid * V
    m_total = m_body + m_fluid

    m_added = m_added_coeff * rho_fluid * V_ext
    m_eff = m_total + m_added

    # Débit volumique
    Q = dV
    mdot = rho_fluid * dV   # débit massique
    v_rel = Q / A_orifice   # vitesse relative d'éjection ou d'aspiration
    

    # Terme masse variable
    F_mass = mdot * (v_rel)

    # Forces extérieures
    F_gravity = m_total * g
    F_buoyancy = rho_fluid * (V_ext-V_max) * g
    F_drag = 0.5 * rho_fluid * Cd * S * v[i] * abs(v[i])

    F_ext = F_buoyancy - F_gravity - F_drag

    # Équation complète
    a = (F_ext + F_mass) / m_eff

    # Intégration
    acc[i+1] = a
    v[i+1] = v[i] + a * dt
    z[i+1] = z[i] + v[i] * dt
    vol[i+1] = V

# =========================
# Graphiques
# =========================

plt.figure()
plt.plot(t, z)
plt.xlabel("Temps (s)")
plt.ylabel("Position (m)")
plt.title("Position verticale")
plt.grid()

plt.figure()
plt.plot(t, v)
plt.xlabel("Temps (s)")
plt.ylabel("Vitesse (m/s)")
plt.title("Vitesse")
plt.grid()

plt.figure()
plt.plot(t, acc)
plt.xlabel("Temps (s)")
plt.ylabel("Accélération (m^2/s)")
plt.title("Accélération")
plt.grid()

plt.figure()
plt.plot(t, vol)
plt.xlabel("Temps (s)")
plt.ylabel("Volume (m^3)")
plt.title("Volume")
plt.grid() 

plt.show()
